# ==============================================================================
# ⚠️  Quant-Pilot 环境变量模板（安全版）
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已加入 .gitignore，不会上传 GitHub。
# ==============================================================================

# ── QMT 交易端配置（机器敏感，禁止硬编码）──────────────────────
QMT_PATH=C:\<券商名称>QMT交易端\userdata_mini
QMT_EXE_PATH=C:\<券商名称>QMT交易端\bin.x64\XtMiniQmt.exe
ACCOUNT_ID=<你的资金账号，纯数字>
QMT_PASSWORD=<你的交易密码>
RESET_TOKEN=<自定义重置口令，用于紧急清仓验证>

# ── N8N 推送配置 ─────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://<你的N8N服务器>/webhook/<端点名称>

# ── 数据与状态目录（可按部署机器调整）──────────────────────────
DATA_DIR=Z:\QuantpC_Workspace\Data\Market_Daily
MASTER_CSV=Z:\QuantpC_Workspace\Data\instrument_master.csv
STATE_DIR=Z:\QuantpC_Workspace\Quant_Pilot\.state
GRID_TARGETS_FILE=Z:\QuantpC_Workspace\Quant_Pilot\.state\grid_targets.yaml
SNIPER_OUTPUT_FILE=Z:\QuantpC_Workspace\Quant_Pilot\.state\sniper_targets.json

# ── LLM & AI 复盘配置（可选）────────────────────────────────────
# DEEPSEEK_API_KEY=<你的 DeepSeek API Key>
